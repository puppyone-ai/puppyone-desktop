{
  "name": "@puppyone/desktop",
  "private": true,
  "version": "0.3.6",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puppyone-ai/puppyone-desktop.git"
  },
  "homepage": "https://github.com/puppyone-ai/puppyone-desktop#readme",
  "bugs": {
    "url": "https://github.com/puppyone-ai/puppyone-desktop/issues"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "puppyoneCapabilities": {
    "externalViewerPacks": false
  },
  "scripts": {
    "generate:interface-styles": "node scripts/generate-interface-styles.mjs",
    "check:interface-styles": "node scripts/generate-interface-styles.mjs --check",
    "check:boundaries": "npm run check:interface-styles && node scripts/check-repository-layout.mjs && node scripts/check-local-workspace-architecture.mjs && node scripts/check-cloud-frontend-architecture.mjs && node scripts/check-repository-target-architecture.mjs && node scripts/check-desktop-build-identity-architecture.mjs && node scripts/check-macos-release-config.mjs && node scripts/check-localization.mjs && node scripts/check-renderer-style-architecture.mjs && node scripts/check-window-layout-architecture.mjs && node scripts/check-native-surface-layering.mjs && node scripts/check-data-ui-boundaries.mjs && node scripts/check-markdown-architecture.mjs && node scripts/check-viewer-contract.mjs && node scripts/check-editor-document-session.mjs && node scripts/check-sidebar-architecture.mjs && node scripts/check-agent-architecture.mjs && node scripts/check-opencode-provenance.mjs && node scripts/check-claude-agent-sdk-provenance.mjs && node scripts/check-agent-ui-provenance.mjs && node scripts/check-automation-plugin-boundaries.mjs",
    "check:localization": "node scripts/check-localization.mjs",
    "check:shared-ui": "node scripts/check-data-ui-boundaries.mjs && node scripts/check-markdown-architecture.mjs && node scripts/check-viewer-contract.mjs && node scripts/check-editor-document-session.mjs",
    "check:editor-document-session": "node scripts/check-editor-document-session.mjs",
    "check:viewer-contract": "node scripts/check-viewer-contract.mjs",
    "check:markdown-architecture": "node scripts/check-markdown-architecture.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare:desktop-build:dev": "node scripts/prepare-desktop-build.mjs --channel dev",
    "dev": "npm run prepare:desktop-build:dev && node scripts/prepare-opencode-dev-runtime.mjs --optional && node scripts/dev-electron.mjs",
    "dev:update-preview": "VITE_DESKTOP_UPDATE_PREVIEW=available VITE_DESKTOP_UPDATE_PREVIEW_VERSION=0.3.0-preview.1 VITE_DESKTOP_CLOUD_API_URL=https://api.puppyone.ai/api/v1 VITE_DESKTOP_CLOUD_WEB_URL=https://app.puppyone.ai npm run dev",
    "dev:renderer": "vite",
    "dev:browser": "vite --host 127.0.0.1",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "build": "node scripts/check-desktop-build-environment.mjs && npm run check:boundaries && tsc && vite build && node scripts/check-renderer-public-assets.mjs && node scripts/check-bundle-budget.mjs && node scripts/check-packaged-artifact-budgets.mjs",
    "package:viewer-pack": "node scripts/package-viewer-pack.mjs",
    "check:artifact-budgets": "node scripts/check-packaged-artifact-budgets.mjs",
    "check:viewer-pack-trust": "node scripts/check-viewer-pack-release.mjs",
    "stage:opencode-runtime": "node scripts/stage-opencode-runtime.mjs",
    "prepare:opencode-runtime": "node scripts/prepare-opencode-dev-runtime.mjs",
    "check:opencode-release": "node scripts/check-opencode-release.mjs",
    "dist:mac": "npm run prepare:desktop-build:dev && npm run dist:mac:prepared",
    "dist:mac:prepared": "npm run check:shared-ui && npm run build && npm run check:viewer-pack-trust && npm run check:opencode-release && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config generated/electron-builder.json --mac --publish never",
    "package:terminal-preview": "node scripts/build-terminal-preview-package.mjs",
    "dist:mac:terminal-preview": "npm run dist:mac && npm run package:terminal-preview",
    "prepare:mac:release": "npm run check:shared-ui && npm run build && npm run check:viewer-pack-trust && npm run check:opencode-release",
    "package:mac:release": "node scripts/build-macos-stable-release.mjs --package-only",
    "dist:mac:release": "node scripts/build-macos-stable-release.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:local-api": "node scripts/smoke-local-api.mjs",
    "smoke:format-aware-diff": "electron scripts/smoke-format-aware-diff.mjs",
    "smoke:csv-table-layout": "electron scripts/smoke-csv-table-sticky-layout.mjs",
    "smoke:office-preview-layout": "electron scripts/smoke-office-preview-layout.mjs",
    "smoke:pptx-renderer": "electron scripts/smoke-pptx-renderer.mjs",
    "smoke:markdown-table-inline-viewport": "electron scripts/smoke-markdown-table-inline-viewport.mjs",
    "smoke:markdown-pane-focus-continuity": "electron scripts/smoke-markdown-pane-focus-continuity.mjs",
    "smoke:codex-agent": "node scripts/smoke-codex-app-server.mjs",
    "smoke:agent-references": "electron scripts/smoke-agent-reference-ingestion.mjs",
    "smoke:viewer-pack": "electron scripts/smoke-viewer-pack.mjs",
    "smoke:app-preview": "electron scripts/smoke-app-preview-iframe.mjs",
    "smoke:pdf-preview": "electron scripts/smoke-pdf-preview.mjs",
    "audit:viewer-gpu": "electron scripts/audit-viewer-gpu.mjs",
    "smoke:renderer-performance": "npm run build && node scripts/run-renderer-performance-smoke.mjs",
    "smoke:renderer-cold-performance": "npm run build && node scripts/run-renderer-performance-smoke.mjs --cold --visible --with-link-index",
    "start": "node scripts/start-electron.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:performance": "vitest bench --run benchmarks/performance --no-file-parallelism --maxWorkers=1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.159",
    "@xterm/addon-web-links": "^0.12.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "intl-messageformat": "^11.2.2",
    "jszip": "^3.10.1",
    "node-pty": "^1.1.0",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@electron/asar": "3.4.1",
    "@formatjs/icu-messageformat-parser": "3.5.5",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.5.0",
    "docx-preview": "^0.4.0",
    "electron": "^41.10.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "^6.2.108",
    "plist": "3.1.0",
    "postcss": "^8.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "saxes": "^6.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "build": {
    "appId": "ai.puppyone.desktop",
    "productName": "puppyone",
    "executableName": "puppyone",
    "electronUpdaterCompatibility": ">=2.16",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "local-api/**",
      "locales/**",
      "shared/**",
      "packages/localization/**",
      "packages/shared-ui/**",
      "vendor/claudian/**",
      "vendor/claude-agent-sdk/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/logo-square.png",
        "to": "logo-square.png"
      },
      {
        "from": "public/logo-square-v0.1.3-light.png",
        "to": "dock-icon-light.png"
      },
      {
        "from": "public/logo-square-v0.1.3-dark.png",
        "to": "dock-icon-matte.png"
      },
      {
        "from": "vendor/opencode",
        "to": "opencode",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.puppyone.ai/desktop/stable/mac/latest",
        "channel": "stable"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "strictVerify": true,
      "notarize": true,
      "executableName": "puppyone",
      "extendInfo": {
        "CFBundleName": "puppyone",
        "CFBundleDisplayName": "puppyone"
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
