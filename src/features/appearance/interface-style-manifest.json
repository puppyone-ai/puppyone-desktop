{
  "version": 1,
  "defaultStyle": "default",
  "storage": {
    "interfaceStyle": "puppyone.desktop.interfaceStyle",
    "themeMode": "puppyone.desktop.theme",
    "lightThemePreset": "puppyone.desktop.lightThemePreset",
    "darkThemePreset": "puppyone.desktop.darkThemePreset",
    "legacyThemePreset": "puppyone.desktop.themePreset"
  },
  "styles": [
    {
      "id": "default",
      "labelKey": "settings.appearance.interfaceStyle.default",
      "palette": {
        "kind": "adaptive",
        "modes": ["system", "light", "dark"],
        "fallbackMode": "system",
        "presetControls": {
          "light": true,
          "dark": true
        }
      },
      "firstPaint": {
        "light": {
          "background": "#fbfaf7",
          "colorScheme": "light"
        },
        "dark": {
          "background": "#161413",
          "colorScheme": "dark"
        }
      },
      "presetFirstPaint": {
        "light": {
          "defaultPreset": "neutral",
          "values": {
            "neutral": {
              "background": "#fbfaf7",
              "colorScheme": "light"
            },
            "warm": {
              "background": "#fbf6ed",
              "colorScheme": "light"
            },
            "graphite": {
              "background": "#fbfbfc",
              "colorScheme": "light"
            }
          }
        },
        "dark": {
          "defaultPreset": "default",
          "values": {
            "default": {
              "background": "#161413",
              "colorScheme": "dark"
            },
            "warm": {
              "background": "#18130f",
              "colorScheme": "dark"
            },
            "graphite": {
              "background": "#17181c",
              "colorScheme": "dark"
            }
          }
        }
      },
      "stylesheet": null
    },
    {
      "id": "windows-xp",
      "labelKey": "settings.appearance.interfaceStyle.windowsXp",
      "palette": {
        "kind": "fixed",
        "mode": "light"
      },
      "firstPaint": {
        "light": {
          "background": "#ffffff",
          "colorScheme": "light"
        }
      },
      "stylesheet": "windows-xp.css"
    },
    {
      "id": "macos-tiger",
      "labelKey": "settings.appearance.interfaceStyle.macosTiger",
      "palette": {
        "kind": "fixed",
        "mode": "light"
      },
      "firstPaint": {
        "light": {
          "background": "#ffffff",
          "colorScheme": "light"
        }
      },
      "stylesheet": "macos-tiger.css"
    }
  ]
}
